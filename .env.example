# Environment Variables Template
# Copy this file to `.env` (or `server/.env` and `client/.env`) before running locally.
# NEVER commit real `.env` secrets to version control.

# ==============================================================================
# BACKEND (server)
# ==============================================================================
PORT=4000
NODE_ENV=development

# Set USE_PGLITE=true for zero-install embedded PostgreSQL during local dev/tests.
# Set USE_PGLITE=false when connecting to local PostgreSQL or Render Managed PostgreSQL.
USE_PGLITE=true
PGLITE_DATA_DIR=./data/pglite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prompthub

# JWT configuration (use a random 32+ character string in production)
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# Optional Google Gemini API key for AI Snippet & Prompt Assistant.
# Leave blank to use the built-in deterministic offline analyzer fallback.
GEMINI_API_KEY=

# ==============================================================================
# FRONTEND (client)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME="Prompt Hub"
